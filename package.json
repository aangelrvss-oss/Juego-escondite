{
  "name": "juego-escondite-s0",
  "private": true,
  "version": "0.0.0",
  "description": "S0: motor de reglas y simulaciones deterministas (sin red, sin app móvil)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"engine/test/*.test.ts\" \"sim/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build:demo": "node demo/build.mjs",
    "test:demo": "node --test \"demo/test/*.test.mjs\"",
    "test:server": "node --test \"server/test/*.test.mjs\"",
    "start:server": "node server/main.ts",
    "sim:panel": "node sim/panel/servidor.mjs",
    "test:sim-panel": "node --test \"sim/panel/test/simulacion.test.mjs\"",
    "test:sim-escenarios": "node --test --test-concurrency=1 \"sim/panel/test/escenarios-completos.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
